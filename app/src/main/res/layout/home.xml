<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false">

    <!-- Wallpaper, date and clock, then the mountain drawn over the clock (the depth effect). -->
    <com.protv.fujihome.DepthClockView
        android:id="@+id/depth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />


    <!-- Warriors during a live game only: a scoreboard centred under the clock, in the Keep watching glass.
         Logos and short names either side, the score between, "● LIVE · Q4 2:31" below. OK opens NBA. -->
    <LinearLayout
        android:id="@+id/nba"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="254dp"
        android:minWidth="250dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/card"
        android:foreground="@drawable/focus_ring_card"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/nbaLogoUs"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/nbaUsName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/nbaCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:fontFeatureSettings="tnum"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/nbaLogoThem"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/nbaThemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/nbaCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.14"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Keep watching above the dock; the cards start at the dock's left edge. -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/cardsBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/keep_watching"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#80000000"
                android:shadowRadius="6" />

            <LinearLayout
                android:id="@+id/cards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Shown while a dock app is being moved. -->
        <TextView
            android:id="@+id/dockHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/pill"
            android:text="@string/dock_move_hint"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/dockScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/band"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Night mode: one dark layer over everything except the moon button. -->
    <View
        android:id="@+id/night"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top left, aligned with the round buttons on the right: the Warriors pill. (Settings is the gear on the right.) -->
    <LinearLayout
        android:id="@+id/topLeft"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="24dp"
        android:layout_marginStart="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Warriors, when no game is live: a small pill like Profile. "GSW vs BOS · Mon 7:00 AM" / "Final · GSW 98–126 MEM". -->
        <LinearLayout
            android:id="@+id/nbaPill"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pill"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/nbaPillLogo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/nbaPillText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pill_text"
                android:textSize="13sp"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:duplicateParentState="true" />
        </LinearLayout>


    </LinearLayout>


    <!-- Top right: everything the original home screen's top bar had, as round glass buttons. -->
    <LinearLayout
        android:id="@+id/topRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp"
        android:orientation="horizontal">

        <ImageView android:id="@+id/btnNotifications" style="@style/RoundButton"
            android:src="@drawable/ic_bell" android:contentDescription="@string/notifications" />
        <ImageView android:id="@+id/btnInputs" style="@style/RoundButton"
            android:src="@drawable/ic_input" android:contentDescription="@string/inputs" />
        <ImageView android:id="@+id/btnWifi" style="@style/RoundButton"
            android:src="@drawable/ic_wifi" android:contentDescription="@string/wifi" />
        <ImageView android:id="@+id/btnSettings" style="@style/RoundButton"
            android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        <ImageView android:id="@+id/moon" style="@style/RoundButton"
            android:src="@drawable/ic_moon" android:contentDescription="@string/night_mode" />
    </LinearLayout>
</FrameLayout>
